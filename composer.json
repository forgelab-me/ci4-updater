{
    "name": "forgelab-me/ci4-updater",
    "description": "Self-update system for CodeIgniter 4 apps: an admin panel that checks a remote update server for new releases, downloads, diffs, backs up, and applies them, with automatic DB migrations. No SSH/git pull required.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "codeigniter",
        "codeigniter4",
        "updater",
        "self-update",
        "deployment",
        "admin-panel"
    ],
    "homepage": "https://github.com/forgelab-me/ci4-updater",
    "authors": [
        {
            "name": "ForgeLab",
            "email": "bertret.elie@gmail.com",
            "homepage": "https://github.com/forgelab-me"
        }
    ],
    "support": {
        "issues": "https://github.com/forgelab-me/ci4-updater/issues",
        "source": "https://github.com/forgelab-me/ci4-updater"
    },
    "require": {
        "php": "^8.1",
        "ext-zip": "*",
        "codeigniter4/framework": "^4.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "codeigniter4/shield": "To protect the admin routes with group/permission-based authorization if you don't already have an auth system in place — see the Security section in the README."
    },
    "autoload": {
        "psr-4": {
            "Forgelabme\\Ci4Updater\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Forgelabme\\Ci4Updater\\Tests\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
